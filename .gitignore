# ==============================================================================
# BasketBrain .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# Datasets and Large Binary Stores (Raw & Intermediate)
archive/
data/raw/*
!data/raw/.gitkeep
data/processed/
data/lakehouse/
data/streaming_input/
data/samples/item_properties.csv
*.parquet
*.snappy.parquet
*.crc

# Keep sample events and category tree for immediate local testing
!data/samples/events.csv
!data/samples/category_tree.csv

# Outputs cache (keep JSON evaluation summaries, ignore heavy scratch files)
outputs/stream/
outputs/visitor_segments.parquet/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Big Data / Spark / Hadoop Scratch Files
derby.log
metastore_db/
spark-warehouse/
*.log
tmp/
.checkpoint/

# IDE & OS Metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
